FROM lscr.io/linuxserver/webtop:ubuntu-xfce

# 1. Gerekli derleme araçlarını kuruyoruz
RUN apt-get update && \
    apt-get install -y build-essential make git wget \
    libasound2-dev libx11-dev libxrandr-dev libxi-dev libgl1-mesa-dev \
    libglu1-mesa-dev libxcursor-dev libxinerama-dev

# 2. Raylib'i doğrudan GitHub'dan çekip kuruyoruz (Kesin Çözüm)
RUN git clone --depth 1 https://github.com/raysan5/raylib.git /tmp/raylib && \
    cd /tmp/raylib/src && \
    make PLATFORM=PLATFORM_DESKTOP && \
    make install && \
    rm -rf /tmp/raylib

# 3. Proje dosyalarınızı sanal masaüstüne kopyalıyoruz
WORKDIR /config/workspace/Uludag_SosyalAg
COPY . /config/workspace/Uludag_SosyalAg

# 4. Konteyner inşa edilirken programı otomatik derliyoruz
RUN make clean && make
